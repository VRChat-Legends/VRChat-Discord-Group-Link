# =============================================================
# VRChat-Discord Group Link - configuration
# Copy this file to .env and fill in every value.
# Never commit .env; it holds real credentials.
# =============================================================

# Discord bot token (discord.com/developers/applications -> Bot -> Token).
# Required intents on the Bot page: Server Members Intent.
DISCORD_TOKEN=

# The Discord server (guild) this bot manages. Right click your server icon
# with Developer Mode on and Copy Server ID.
DISCORD_GUILD_ID=

# VRChat group ID the bot manages (grp_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
# Find it in the group page URL on vrchat.com.
VRCHAT_GROUP_ID=

# =============================================================
# VRChat account (server-side only; use a dedicated account that has
# permission to manage roles in your group). TOTP secret is the base32
# string shown when you enable 2FA (NOT a 6 digit code).
# =============================================================
VRCHAT_EMAIL=
VRCHAT_PASSWORD=
VRCHAT_TOTP_SECRET=

# Optional: paste a valid auth cookie to skip password login (rotate if leaked).
# VRCHAT_AUTH_COOKIE=

# =============================================================
# Sync behavior
# =============================================================
# How often the auto sync runs, in seconds. Minimum 60. The bot spreads its
# VRChat API calls out to respect rate limits, so very low values just queue.
SYNC_INTERVAL_SECONDS=300

# VRChat API pacing (safe defaults; only lower them if you know what you are doing)
VRCHAT_MIN_INTERVAL_MS=1000
VRCHAT_MAX_REQUESTS_PER_MINUTE=30

# =============================================================
# Logging
# =============================================================
# error | warn | info | debug
LOG_LEVEL=info
# Also write logs to data/logs/YYYY-MM-DD.log (1 = on, 0 = off)
LOG_TO_FILE=1
